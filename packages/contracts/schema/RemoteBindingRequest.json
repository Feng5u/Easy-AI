{
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "connectionId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Connectionid",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Requestid",
      "type": "string"
    },
    "expectedRevision": {
      "minimum": 1,
      "title": "Expectedrevision",
      "type": "integer"
    },
    "expectedProgramHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expectedprogramhash",
      "type": "string"
    },
    "probeRequestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Proberequestid",
      "type": "string"
    },
    "runBase": {
      "maxLength": 1024,
      "minLength": 2,
      "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
      "title": "Runbase",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "connectionId",
    "requestId",
    "expectedRevision",
    "expectedProgramHash",
    "probeRequestId",
    "runBase"
