{
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "connectionId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Connectionid",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Requestid",
      "type": "string"
    },
    "condaPath": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 2,
          "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condapath"
    },
    "pythonPath": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 2,
          "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pythonpath"
    }
  },
  "required": [
    "projectId",
    "connectionId",
    "requestId"
  ],
  "title": "EnvironmentDiscoveryRequest",
  "type": "object"
}
