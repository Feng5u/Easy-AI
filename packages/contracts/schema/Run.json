{
  "$defs": {
    "ArtifactSyncFailure": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "scope",
            "owner_poll",
            "snapshot",
            "event_prefix",
            "receipt_read",
            "receipt_digest",
            "receipt_records",
            "cache_open",
            "artifact_read",
            "artifact_verify",
            "cache_commit",
            "channel_cleanup",
            "cache_cleanup",
            "watcher_cleanup",
            "completion",
            "unknown"
          ],
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "enum": [
            "SYNC_INVALID_EVIDENCE",
            "SYNC_IO_FAILED",
            "SYNC_CANCELLED",
            "SYNC_DEADLINE",
            "SYNC_AUTH_STALE",
            "SYNC_BUSY",
            "SYNC_CLEANUP_UNCONFIRMED",
            "SYNC_REQUIRED_ARTIFACTS_MISSING",
            "SYNC_UNKNOWN"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "code"
      ],
      "title": "ArtifactSyncFailure",
      "type": "object"
    },
    "ArtifactSyncProgress": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "default": "idle",
          "enum": [
            "idle",
            "syncing",
            "paused",
            "cleanup_pending",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "receivedBytes": {
          "default": 0,
          "maximum": 268435456,
          "minimum": 0,
          "title": "Receivedbytes",
          "type": "integer"
        },
        "verifiedBytes": {
          "default": 0,
          "maximum": 268435456,
          "minimum": 0,
          "title": "Verifiedbytes",
          "type": "integer"
        },
        "totalBytes": {
          "default": 0,
          "maximum": 268435456,
          "minimum": 0,
          "title": "Totalbytes",
          "type": "integer"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactSyncFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cleanupFailure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactSyncFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ArtifactSyncProgress",
      "type": "object"
    },
    "QuickLimits": {
      "additionalProperties": false,
      "properties": {
        "epochs": {
          "const": 1,
          "default": 1,
          "title": "Epochs",
          "type": "integer"
        },
        "trainSamples": {
          "const": 1024,
          "default": 1024,
          "title": "Trainsamples",
          "type": "integer"
        },
        "testSamples": {
          "const": 256,
          "default": 256,
          "title": "Testsamples",
          "type": "integer"
        }
      },
      "title": "QuickLimits",
      "type": "object"
    },
    "RemoteExecution": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        },
        "hostFingerprint": {
          "title": "Hostfingerprint",
          "type": "string"
        },
        "executionState": {
          "enum": [
            "CREATED",
            "STAGING",
            "STARTING",
            "RUNNING",
            "CANCELLING",
            "CLEANUP_PENDING",
            "COMPLETED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "Executionstate",
          "type": "string"
        },
        "startOutcome": {
          "enum": [
            "not_attempted",
            "unknown",
            "acknowledged"
          ],
          "title": "Startoutcome",
          "type": "string"
        },
        "cancelState": {
          "enum": [
            "none",
            "pending",
            "acknowledged",
            "resolved"
          ],
          "title": "Cancelstate",
          "type": "string"
        },
        "artifactsVerified": {
          "default": false,
          "title": "Artifactsverified",
          "type": "boolean"
        }
      },
      "required": [
        "host",
        "port",
        "username",
        "hostFingerprint",
        "executionState",
        "startOutcome",
        "cancelState"
      ],
      "title": "RemoteExecution",
      "type": "object"
    },
    "RunConfig": {
      "additionalProperties": false,
      "properties": {
        "configVersion": {
          "const": 1,
          "default": 1,
          "title": "Configversion",
          "type": "integer"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
        },
        "projectRevision": {
          "minimum": 1,
          "title": "Projectrevision",
          "type": "integer"
        },
        "programHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Programhash",
          "type": "string"
        },
        "codeHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Codehash",
          "type": "string"
        },
        "bundleHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundlehash",
          "type": "string"
        },
        "targetId": {
          "title": "Targetid",
          "type": "string"
        },
        "runner": {
          "enum": [
            "local",
            "ssh"
          ],
          "title": "Runner",
          "type": "string"
        },
        "dataRoot": {
          "title": "Dataroot",
          "type": "string"
        },
        "runRoot": {
          "title": "Runroot",
          "type": "string"
        },
        "pythonExecutable": {
          "title": "Pythonexecutable",
          "type": "string"
        },
        "environmentPrefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environmentprefix"
        },
        "condaExecutable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condaexecutable"
        },
        "device": {
          "default": "auto",
          "enum": [
            "auto",
            "cpu",
            "cuda",
            "mps"
          ],
          "title": "Device",
          "type": "string"
        },
        "executionMode": {
          "enum": [
            "full",
            "quick"
          ],
          "title": "Executionmode",
          "type": "string"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "numWorkers": {
          "maximum": 16,
          "minimum": 0,
          "title": "Numworkers",
          "type": "integer"
        },
        "pinMemoryPolicy": {
          "const": "cuda_only",
          "default": "cuda_only",
          "title": "Pinmemorypolicy",
          "type": "string"
        },
        "quickLimits": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuickLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "runId",
        "projectId",
        "projectRevision",
        "programHash",
        "codeHash",
        "bundleHash",
        "targetId",
        "runner",
        "dataRoot",
        "runRoot",
        "pythonExecutable",
        "executionMode",
        "seed",
        "numWorkers"
      ],
      "title": "RunConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "status": {
      "enum": [
        "CREATED",
        "PRECHECKING",
        "STAGING",
        "STARTING",
        "RUNNING",
        "CLEANUP_PENDING",
        "COMPLETED",
        "SUCCEEDED",
        "FAILED",
        "CANCELLING",
        "CANCELLED",
        "INTERRUPTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "connectionState": {
      "enum": [
        "connected",
        "disconnected",
        "reconnecting"
      ],
      "title": "Connectionstate",
      "type": "string"
    },
    "syncState": {
      "enum": [
        "pending",
        "syncing",
        "complete",
        "error"
      ],
      "title": "Syncstate",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/RunConfig"
    },
    "remote": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemoteExecution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifactSync": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactSyncProgress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "runId",
    "projectId",
    "status",
    "connectionState",
    "syncState",
    "config"
  ],
  "title": "Run",
  "type": "object"
}
