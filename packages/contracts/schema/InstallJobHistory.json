{
  "$defs": {
    "InstallJobSummary": {
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Jobid",
          "type": "string"
        },
        "environmentId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Environmentid",
          "type": "string"
        },
        "planId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Planid",
          "type": "string"
        },
        "planHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Planhash",
          "type": "string"
        },
        "recordedAt": {
          "format": "date-time",
          "title": "Recordedat",
          "type": "string"
        },
        "recordedState": {
          "enum": [
            "AWAITING_EXECUTION",
            "INSTALLING",
            "VERIFYING",
            "SUCCEEDED",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED"
          ],
          "title": "Recordedstate",
          "type": "string"
        },
        "state": {
          "enum": [
            "AWAITING_EXECUTION",
            "INSTALLING",
            "VERIFYING",
            "SUCCEEDED",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED"
          ],
          "title": "State",
          "type": "string"
        },
        "statusCode": {
          "title": "Statuscode",
          "type": "string"
        },
        "origin": {
          "enum": [
            "current",
            "recovered",
            "external"
          ],
          "title": "Origin",
          "type": "string"
        },
        "workerAlive": {
          "title": "Workeralive",
          "type": "boolean"
        },
        "observation": {
          "enum": [
            "managed-worker-alive",
            "registered-only",
            "historical",
            "stop-unconfirmed"
          ],
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "jobId",
        "environmentId",
        "planId",
        "planHash",
        "recordedAt",
        "recordedState",
        "state",
        "statusCode",
        "origin",
        "workerAlive",
        "observation"
      ],
      "title": "InstallJobSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/InstallJobSummary"
      },
      "maxItems": 64,
      "title": "Entries",
      "type": "array"
    },
    "limit": {
      "const": 64,
      "default": 64,
      "title": "Limit",
      "type": "integer"
    }
  },
  "required": [
    "entries"
  ],
  "title": "InstallJobHistory",
  "type": "object"
}
