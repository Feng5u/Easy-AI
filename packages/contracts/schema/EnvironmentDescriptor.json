{
  "additionalProperties": false,
  "properties": {
    "environmentId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Environmentid",
      "type": "string"
    },
    "kind": {
      "enum": [
        "conda",
        "python"
      ],
      "title": "Kind",
      "type": "string"
    },
    "location": {
      "maxLength": 1024,
      "minLength": 2,
      "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
      "title": "Location",
      "type": "string"
    },
    "readOnly": {
      "const": true,
      "default": true,
      "title": "Readonly",
      "type": "boolean"
    }
  },
  "required": [
    "environmentId",
    "kind",
    "location"
  ],
  "title": "EnvironmentDescriptor",
  "type": "object"
}
