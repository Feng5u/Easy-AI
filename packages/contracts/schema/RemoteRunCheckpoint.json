{
  "$defs": {
    "ArtifactReceipt": {
      "additionalProperties": false,
      "description": "Immutable manifest and exact raw-event prefix, published before owner status.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "sourceSeq": {
          "minimum": 1,
          "title": "Sourceseq",
          "type": "integer"
        },
        "eventsSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Eventssha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "sourceSeq",
        "eventsSha256"
      ],
      "title": "ArtifactReceipt",
      "type": "object"
    },
    "RemoteRunIdentity": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Projectid",
          "type": "string"
        },
        "targetId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Targetid",
          "type": "string"
        },
        "runId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Runid",
          "type": "string"
        },
        "launchId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Launchid",
          "type": "string"
        },
        "username": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x20\\x7f]+$",
          "title": "Username",
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/SshEndpoint"
        },
        "hostFingerprint": {
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
          "title": "Hostfingerprint",
          "type": "string"
        },
        "runRoot": {
          "maxLength": 1024,
          "minLength": 2,
          "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
          "title": "Runroot",
          "type": "string"
        },
        "programHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Programhash",
          "type": "string"
        },
        "codeHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Codehash",
          "type": "string"
        },
        "bundleHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundlehash",
          "type": "string"
        },
        "configHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Confighash",
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "targetId",
        "runId",
        "launchId",
        "username",
        "endpoint",
        "hostFingerprint",
        "runRoot",
        "programHash",
        "codeHash",
        "bundleHash",
        "configHash"
      ],
      "title": "RemoteRunIdentity",
      "type": "object"
    },
    "RemoteRunObservation": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/RemoteRunIdentity"
        },
        "heartbeat": {
          "minimum": 1,
          "title": "Heartbeat",
          "type": "integer"
        },
        "artifactReceipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReceipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "STARTING",
            "RUNNING",
            "CANCELLING",
            "CLEANUP_PENDING",
            "COMPLETED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "State",
          "type": "string"
        },
        "sealed": {
          "title": "Sealed",
          "type": "boolean"
        },
        "spawnFailed": {
          "default": false,
          "title": "Spawnfailed",
          "type": "boolean"
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exitcode"
        },
        "streams": {
          "$ref": "#/$defs/RemoteStreams"
        }
      },
      "required": [
        "identity",
        "heartbeat",
        "state",
        "sealed",
        "streams"
      ],
      "title": "RemoteRunObservation",
      "type": "object"
    },
    "RemoteStream": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Generation",
          "type": "string"
        },
        "sizeBytes": {
          "maximum": 134217728,
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "generation",
        "sizeBytes",
        "sha256"
      ],
      "title": "RemoteStream",
      "type": "object"
    },
    "RemoteStreams": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "$ref": "#/$defs/RemoteStream"
        },
        "stdout": {
          "$ref": "#/$defs/RemoteStream"
        },
        "stderr": {
          "$ref": "#/$defs/RemoteStream"
        }
      },
      "required": [
        "events",
        "stdout",
        "stderr"
      ],
      "title": "RemoteStreams",
      "type": "object"
    },
    "SshEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "SshEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": 1,
      "default": 1,
      "title": "Protocolversion",
      "type": "integer"
    },
    "identity": {
      "$ref": "#/$defs/RemoteRunIdentity"
    },
    "startOutcome": {
      "default": "not_attempted",
      "enum": [
        "not_attempted",
        "unknown",
        "acknowledged"
      ],
      "title": "Startoutcome",
      "type": "string"
    },
    "cancelState": {
      "default": "none",
      "enum": [
        "none",
        "pending",
        "acknowledged",
        "resolved"
      ],
      "title": "Cancelstate",
      "type": "string"
    },
    "executionState": {
      "default": "CREATED",
      "enum": [
        "CREATED",
        "STAGING",
        "STARTING",
        "RUNNING",
        "CANCELLING",
        "CLEANUP_PENDING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "Executionstate",
      "type": "string"
    },
    "connectionState": {
      "default": "disconnected",
      "enum": [
        "connected",
        "disconnected"
      ],
      "title": "Connectionstate",
      "type": "string"
    },
    "artifactsVerified": {
      "const": false,
      "default": false,
      "title": "Artifactsverified",
      "type": "boolean"
    },
    "cancelledBeforeStart": {
      "default": false,
      "title": "Cancelledbeforestart",
      "type": "boolean"
    },
    "lastConnectionId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastconnectionid"
    },
    "lastObservation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemoteRunObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "identity"
  ],
  "title": "RemoteRunCheckpoint",
  "type": "object"
}
