{
  "$defs": {
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Projectid",
          "type": "string"
        },
        "connectionId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Connectionid",
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/SshEndpoint"
        },
        "hostFingerprint": {
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
          "title": "Hostfingerprint",
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "connectionId",
        "endpoint",
        "hostFingerprint"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "SshEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "SshEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Requestid",
      "type": "string"
    },
    "identityRequestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Identityrequestid",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EnvironmentScope"
    },
    "username": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Username",
      "type": "string"
    },
    "authenticated": {
      "const": true,
      "default": true,
      "title": "Authenticated",
      "type": "boolean"
    },
    "method": {
      "const": "password",
      "default": "password",
      "title": "Method",
      "type": "string"
    },
    "expiresInSeconds": {
      "maximum": 300,
      "minimum": 1,
      "title": "Expiresinseconds",
      "type": "integer"
    }
  },
  "required": [
    "projectId",
    "requestId",
    "identityRequestId",
    "scope",
    "username",
    "expiresInSeconds"
  ],
  "title": "AuthenticatedConnection",
  "type": "object"
}
