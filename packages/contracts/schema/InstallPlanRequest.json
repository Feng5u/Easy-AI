{
  "$defs": {
    "NewEnvironmentSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "NewEnvironmentSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "targetId": {
      "const": "local",
      "title": "Targetid",
      "type": "string"
    },
    "profileId": {
      "enum": [
        "teacher-existing",
        "easyai-cpu"
      ],
      "title": "Profileid",
      "type": "string"
    },
    "packageIds": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "type": "string"
      },
      "maxItems": 17,
      "minItems": 1,
      "title": "Packageids",
      "type": "array"
    },
    "ownedEnvironmentId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ownedenvironmentid"
    },
    "newEnvironmentSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/NewEnvironmentSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "targetId",
    "profileId",
    "packageIds"
  ],
  "title": "InstallPlanRequest",
  "type": "object"
}
