{
  "additionalProperties": false,
  "properties": {
    "transferId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Transferid",
      "type": "string"
    },
    "planId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Planid",
      "type": "string"
    },
    "planHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Planhash",
      "type": "string"
    },
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "connectionId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Connectionid",
      "type": "string"
    },
    "targetPath": {
      "maxLength": 1024,
      "minLength": 2,
      "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
      "title": "Targetpath",
      "type": "string"
    },
    "status": {
      "enum": [
        "UPLOADING",
        "VERIFYING",
        "CANCELLING",
        "CLEANUP_PENDING",
        "COMPLETED",
        "CANCELLED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "fileCount": {
      "maximum": 256,
      "minimum": 1,
      "title": "Filecount",
      "type": "integer"
    },
    "totalBytes": {
      "maximum": 268435456,
      "minimum": 0,
      "title": "Totalbytes",
      "type": "integer"
    },
    "reusedBytes": {
      "default": 0,
      "maximum": 268435456,
      "minimum": 0,
      "title": "Reusedbytes",
      "type": "integer"
    },
    "sentBytes": {
      "default": 0,
      "maximum": 268435456,
      "minimum": 0,
      "title": "Sentbytes",
      "type": "integer"
    },
    "verifiedBytes": {
      "default": 0,
      "maximum": 268435456,
      "minimum": 0,
      "title": "Verifiedbytes",
      "type": "integer"
    },
    "completedFiles": {
      "default": 0,
      "maximum": 256,
      "minimum": 0,
      "title": "Completedfiles",
      "type": "integer"
    },
    "errorCode": {
      "anyOf": [
        {
          "enum": [
            "DATA_TRANSFER_AUTH_STALE",
            "DATA_TRANSFER_BUSY",
            "DATA_TRANSFER_CANCELLED",
            "DATA_TRANSFER_CLEANUP_PENDING",
            "DATA_TRANSFER_CLEANUP_FAILED",
            "DATA_TRANSFER_CLOSED",
            "DATA_TRANSFER_CONFIRMATION_INVALID",
            "DATA_TRANSFER_CONFIRMATION_REQUIRED",
            "DATA_TRANSFER_FAILED",
            "DATA_TRANSFER_RECOVERY_INVALID",
            "DATA_TRANSFER_PERSISTENCE_FAILED",
            "DATA_TRANSFER_HASH_MISMATCH",
            "DATA_TRANSFER_HOME_CHANGED",
            "DATA_TRANSFER_HOME_INVALID",
            "DATA_TRANSFER_JOB_LIMIT",
            "DATA_TRANSFER_MANIFEST_LIMIT",
            "DATA_TRANSFER_NOT_FOUND",
            "DATA_TRANSFER_PLAN_EXPIRED",
            "DATA_TRANSFER_PROGRESS_INVALID",
            "DATA_TRANSFER_SOURCE_CHANGED",
            "DATA_TRANSFER_SOURCE_EMPTY",
            "DATA_TRANSFER_SOURCE_FORBIDDEN",
            "DATA_TRANSFER_SOURCE_LIMIT",
            "DATA_TRANSFER_START_FAILED",
            "DATA_TRANSFER_TARGET_REQUIRED",
            "DATA_TRANSFER_TARGET_UNOWNED",
            "DATA_TRANSFER_TIMEOUT",
            "DATA_TRANSFER_VERIFICATION_INCOMPLETE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errorcode"
    },
    "dataReady": {
      "const": false,
      "default": false,
      "title": "Dataready",
      "type": "boolean"
    }
  },
  "required": [
    "transferId",
    "planId",
    "planHash",
    "projectId",
    "connectionId",
    "targetPath",
    "status",
    "fileCount",
    "totalBytes"
  ],
  "title": "TransferJob",
  "type": "object"
}
