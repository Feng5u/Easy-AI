{
  "$defs": {
    "ArtifactSyncFailure": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "scope",
            "owner_poll",
            "snapshot",
            "event_prefix",
            "receipt_read",
            "receipt_digest",
            "receipt_records",
            "cache_open",
            "artifact_read",
            "artifact_verify",
            "cache_commit",
            "channel_cleanup",
            "cache_cleanup",
            "watcher_cleanup",
            "completion",
            "unknown"
          ],
          "title": "Stage",
          "type": "string"
        },
        "code": {
          "enum": [
            "SYNC_INVALID_EVIDENCE",
            "SYNC_IO_FAILED",
            "SYNC_CANCELLED",
            "SYNC_DEADLINE",
            "SYNC_AUTH_STALE",
            "SYNC_BUSY",
            "SYNC_CLEANUP_UNCONFIRMED",
            "SYNC_REQUIRED_ARTIFACTS_MISSING",
            "SYNC_UNKNOWN"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "code"
      ],
      "title": "ArtifactSyncFailure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state": {
      "default": "idle",
      "enum": [
        "idle",
        "syncing",
        "paused",
        "cleanup_pending",
        "error"
      ],
      "title": "State",
      "type": "string"
    },
    "receivedBytes": {
      "default": 0,
      "maximum": 268435456,
      "minimum": 0,
      "title": "Receivedbytes",
      "type": "integer"
    },
    "verifiedBytes": {
      "default": 0,
      "maximum": 268435456,
      "minimum": 0,
      "title": "Verifiedbytes",
      "type": "integer"
    },
    "totalBytes": {
      "default": 0,
      "maximum": 268435456,
      "minimum": 0,
      "title": "Totalbytes",
      "type": "integer"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactSyncFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cleanupFailure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactSyncFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "ArtifactSyncProgress",
  "type": "object"
}
