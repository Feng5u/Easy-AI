{
  "$defs": {
    "SshEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "SshEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "connectionId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Connectionid",
      "type": "string"
    },
    "endpoint": {
      "$ref": "#/$defs/SshEndpoint"
    },
    "hostFingerprint": {
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "title": "Hostfingerprint",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "connectionId",
    "endpoint",
    "hostFingerprint"
  ],
  "title": "EnvironmentScope",
  "type": "object"
}
