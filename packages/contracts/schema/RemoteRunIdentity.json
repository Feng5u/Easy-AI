{
  "$defs": {
    "SshEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "SshEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "targetId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Targetid",
      "type": "string"
    },
    "runId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Runid",
      "type": "string"
    },
    "launchId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Launchid",
      "type": "string"
    },
    "username": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x20\\x7f]+$",
      "title": "Username",
      "type": "string"
    },
    "endpoint": {
      "$ref": "#/$defs/SshEndpoint"
    },
    "hostFingerprint": {
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "title": "Hostfingerprint",
      "type": "string"
    },
    "runRoot": {
      "maxLength": 1024,
      "minLength": 2,
      "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
      "title": "Runroot",
      "type": "string"
    },
    "programHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Programhash",
      "type": "string"
    },
    "codeHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Codehash",
      "type": "string"
    },
    "bundleHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundlehash",
      "type": "string"
    },
    "configHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Confighash",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "targetId",
    "runId",
    "launchId",
    "username",
    "endpoint",
    "hostFingerprint",
    "runRoot",
    "programHash",
    "codeHash",
    "bundleHash",
    "configHash"
  ],
  "title": "RemoteRunIdentity",
  "type": "object"
}
