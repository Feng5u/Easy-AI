{
  "$defs": {
    "EnvironmentDescriptor": {
      "additionalProperties": false,
      "properties": {
        "environmentId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Environmentid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "conda",
            "python"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "maxLength": 1024,
          "minLength": 2,
          "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
          "title": "Location",
          "type": "string"
        },
        "readOnly": {
          "const": true,
          "default": true,
          "title": "Readonly",
          "type": "boolean"
        }
      },
      "required": [
        "environmentId",
        "kind",
        "location"
      ],
      "title": "EnvironmentDescriptor",
      "type": "object"
    },
    "EnvironmentScope": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Projectid",
          "type": "string"
        },
        "connectionId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Connectionid",
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/SshEndpoint"
        },
        "hostFingerprint": {
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
          "title": "Hostfingerprint",
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "connectionId",
        "endpoint",
        "hostFingerprint"
      ],
      "title": "EnvironmentScope",
      "type": "object"
    },
    "SshEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "SshEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "connectionId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Connectionid",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Requestid",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EnvironmentScope"
    },
    "environments": {
      "items": {
        "$ref": "#/$defs/EnvironmentDescriptor"
      },
      "maxItems": 64,
      "title": "Environments",
      "type": "array"
    },
    "condaExecutable": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 2,
          "pattern": "^/[^\\\\\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condaexecutable"
    },
    "condaVersion": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condaversion"
    },
    "note": {
      "default": "unprobed",
      "enum": [
        "unprobed",
        "conda_not_found"
      ],
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "connectionId",
    "requestId",
    "scope",
    "environments"
  ],
  "title": "EnvironmentCatalog",
  "type": "object"
}
