{
  "additionalProperties": false,
  "properties": {
    "targetId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Targetid"
    },
    "targetRevision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Targetrevision"
    },
    "projectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Projectid",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Requestid",
      "type": "string"
    },
    "identityRequestId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Identityrequestid",
      "type": "string"
    },
    "expectedFingerprint": {
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "title": "Expectedfingerprint",
      "type": "string"
    },
    "username": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Username",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "requestId",
    "identityRequestId",
    "expectedFingerprint",
    "username"
  ],
  "title": "AuthenticationRequest",
  "type": "object"
}
